{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "ESNext.Disposable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["extensions/**/*.ts", "test/**/*.ts"]
}
